{"level":20,"time":1777760421172,"pid":2295,"hostname":"runnervmeorf1","input":"{\n  \"path\": \"components/Features.tsx\",\n  \"content\": \"\\\"use client\\\";\\nimport React from 'react';\\nimport { motion } from 'framer-motion';\\nimport { \\n  Zap, \\n  Share2, \\n  BrainCircuit, \\n  ShieldCheck, \\n  Activity, \\n  Lock \\n} from 'lucide-react';\\n\\nconst features = [\\n  {\\n    title: 'Visual Workflow Builder',\\n    description: 'Drag-and-drop automation in minutes. Map your business processes visually without writing a single line of code.',\\n    icon: Zap,\\n    label: '01 // ENGINE'\\n  },\\n  {\\n    title: '200+ Integrations',\\n    description: 'Native connections to Slack, Notion, GitHub, Linear, and more. Your entire stack, unified in one place.',\\n    icon: Share2,\\n    label: '02 // CONNECT'\\n  },\\n  {\\n    title: 'Smart Triggers',\\n    description: 'Event-based, schedule-based, or AI-inferred triggers that react to your data in real-time.',\\n    icon: BrainCircuit,\\n    label: '03 // INTELLIGENCE'\\n  },\\n  {\\n    title: 'Team Permissions',\\n    description: 'Role-based access control with detailed audit logs to ensure the right people have the right access.',\\n    icon: Lock,\\n    label: '04 // GOVERNANCE'\\n  },\\n  {\\n    title: 'Real-time Monitoring',\\n    description: 'Live run logs and instant failure alerts. Know exactly where your automation is and why it happened.',\\n    icon: Activity,\\n    label: '05 // OBSERVABILITY'\\n  },\\n  {\\n    title: 'SOC 2 Compliant',\\n    description: 'Enterprise-grade security out of the box. We handle the compliance so you can handle the growth.',\\n    icon: ShieldCheck,\\n    label: '06 // SECURITY'\\n  },\\n];\\n\\nexport default function Features() {\\n  return (\\n    <section id=\\\"features\\\" className=\\\"py-24 border-t border-border relative\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"mb-16\\\">\\n          <h2 className=\\\"text-3xl md:text-5xl font-bold tracking-tighter mb-4\\\">\\n            Engineered for <span className=\\\"text-accent\\\">Velocity.</span>\\n          </h2>\\n          <p className=\\\"text-muted max-w-xl text-lg\\\">\\n            Everything you need to eliminate the repetitive and focus on the creative.\\n          </p>\\n        </div>\\n        \\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border border border-border\\\">\\n          {features.map((feature, index) => (\\n            <motion.div \\n              key={index}\\n              whileHover={{ backgroundColor: 'rgba(245, 166, 35, 0.02)' }}\\n              className=\\\"bg-background p-8 transition-colors group\\\"\\n            >\\n              <div className=\\\"flex flex-col h-full\\\">\\n                <div className=\\\"flex items-start justify-between mb-6\\\">\\n                  <div className=\\\"p-2 border border-border group-hover:border-accent transition-colors\\\">\\n                    <feature.icon size={24} className=\\\"text-accent\\\" />\\n                  </div>\\n                  <span className=\\\"text-[10px] font-mono text-muted tracking-widest\\\">\\n                    {feature.label}\\n                  </span>\\n                </div>\\n                <h3 className=\\\"text-xl font-bold mb-3\\\">{feature.title}</h3>\\n                <p className=\\\"text-muted leading-relaxed mb-6\\\">\\n                  {feature.description}\\n                </p>\\n                <div className=\\\"mt-auto pt-6 border-t border-border/50\\\">\\n                  <a href=\\\"#\\\" className=\\\"text-xs font-bold text-accent uppercase tracking-widest hover:underline\\\">\\n                    Learn more →\\n                  </a>\\n                </div>\\n              </div>\\n            </motion.div>\\n          ))}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\",\n  \"createParentDirectories\": true\n}","msg":"Tool call: createFile"}
