{"level":20,"time":1777760490299,"pid":2295,"hostname":"runnervmeorf1","input":"{\n  \"path\": \"components/Pricing.tsx\",\n  \"content\": \"\\\"use client\\\";\\nimport React from 'react';\\nimport { motion } from 'framer-motion';\\nimport { Check } from 'lucide-react';\\n\\nconst plans = [\\n  {\\n    name: 'Starter',\\n    price: 'Free',\\n    description: 'Perfect for individuals and side projects.',\\n    features: ['3 workflows', '500 runs/mo', 'Community support', 'Basic integrations'],\\n    cta: 'Get started',\\n    popular: false,\\n  },\\n  {\\n    name: 'Pro',\\n    price: '$29',\\n    description: 'Scale your team with unlimited power.',\\n    features: ['Unlimited workflows', '50k runs/mo', 'Priority support', 'All integrations', 'Advanced triggers'],\\n    cta: 'Start free trial',\\n    popular: true,\\n  },\\n  {\\n    name: 'Enterprise',\\n    price: 'Custom',\\n    description: 'Custom infrastructure for large scale.',\\n    features: ['SSO & SAML', 'Custom SLA', 'Dedicated account manager', 'On-premise option', 'Audit logs'],\\n    cta: 'Contact sales',\\n    popular: false,\\n  },\\n];\\n\\nexport default function Pricing() {\\n  return (\\n    <section id=\\\"pricing\\\" className=\\\"py-24 border-t border-border relative\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"text-center mb-16\\\">\\n          <h2 className=\\\"text-3xl md:text-5xl font-bold tracking-tighter mb-4\\\">\\n            Simple, <span className=\\\"text-accent\\\">Transparent</span> Pricing.\\n          </h2>\\n          <p className=\\\"text-muted max-w-xl mx-auto text-lg\\\">\\n            No hidden fees. Scale your automation as your team grows.\\n          </p>\\n        </div>\\n        \\n        <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n          {plans.map((plan, index) => (\\n            <div \\n              key={index} \\n              className={`relative p-8 rounded-sm border transition-all ${\\n                plan.popular \\n                  ? 'border-accent bg-accent/5 scale-105 z-10' \\n                  : 'border-border bg-background'\\n              }`}\\n            >\\n              {plan.popular && (\\n                <div className=\\\"absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-accent text-accent-foreground px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest\\\">\\n                  Most Popular\\n                </div>\\n              )}\\n              \\n              <div className=\\\"mb-8\\\">\\n                <h3 className=\\\"text-xl font-bold mb-2\\\">{plan.name}</h3>\\n                <div className=\\\"flex items-baseline gap-1 mb-2\\\">\\n                  <span className=\\\"text-4xl font-bold\\\">{plan.price}</span>\\n                  {plan.price !== 'Custom' && <span className=\\\"text-muted text-sm\\\">/mo</span>}\\n                </div>\\n                <p className=\\\"text-muted text-sm leading-relaxed\\\">\\n                  {plan.description}\\n                </p>\\n              </div>\\n              \\n              <ul className=\\\"space-y-4 mb-8\\\">\\n                {plan.features.map((feature, fIndex) => (\\n                  <li key={fIndex} className=\\\"flex items-center gap-3 text-sm\\\">\\n                    <Check size={16} className=\\\"text-accent flex-shrink-0\\\" />\\n                    <span className=\\\"text-muted\\\">{feature}</span>\\n                  </li>\\n                ))}\\n              </ul>\\n              \\n              <a \\n                href=\\\"#\\\" \\n                className={`block w-full text-center py-3 rounded-sm font-bold transition-all ${\\n                  plan.popular \\n                    ? 'bg-accent text-accent-foreground hover:bg-opacity-90' \\n                    : 'border border-border hover:bg-border/50'\\n                }`}\\n              >\\n                {plan.cta}\\n              </a>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\",\n  \"createParentDirectories\": true\n}","msg":"Tool call: createFile"}
