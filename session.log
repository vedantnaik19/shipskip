{"level":20,"time":1777760611883,"pid":2295,"hostname":"runnervmeorf1","input":"{\n  \"path\": \"components/FAQ.tsx\",\n  \"content\": \"\\\"use client\\\";\\nimport React, { useState } from 'react';\\nimport { motion, AnimatePresence } from 'framer-motion';\\nimport { Plus, Minus } from 'lucide-react';\\n\\nconst faqs = [\\n  {\\n    question: 'How does Flowmatic differ from Zapier or Make?',\\n    answer: 'While other tools focus on simple linear triggers, Flowmatic is built for complex, AI-driven workflows. We offer native AI-inference triggers, deeper observability with real-time logs, and a \\\"technical-first\\\" approach to stability and versioning.',\\n  },\\n  {\\n    question: 'Do I need to know how to code to use Flowmatic?',\\n    answer: 'Absolutely not. Our visual builder allows you to map out entire business processes using a drag-and-drop interface. However, if you are a developer, we provide advanced options for custom webhooks and JSON transformations.',\\n  },\\n  {\\n    question: 'How secure is my data in Flowmatic?',\\n    answer: 'Security is our core priority. We are SOC 2 compliant and use AES-256 encryption for all data at rest. We never store your credentials in plain text and provide full audit logs for every action taken within your workspace.',\\n  },\\n  {\\n    question: 'Can I migrate my existing workflows from other tools?',\\n    answer: 'Yes, we provide a set of import utilities for the most popular automation platforms, allowing you to bring your existing logic into Flowmatic with minimal reconfiguration.',\\n  },\\n  {\\n    question: 'What happens if a workflow fails?',\\n    answer: 'Flowmatic provides real-time failure alerts via Slack, Email, or Webhook. You can inspect the exact step that failed in the run logs, fix the logic, and replay the failed event with a single click.',\\n  },\\n];\\n\\nexport default function FAQ() {\\n  const [openIndex, setOpenIndex] = useState<number | null>(null);\\n\\n  return (\\n    <section id=\\\"faq\\\" className=\\\"py-24 border-t border-border\\\">\\n      <div className=\\\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"text-center mb-16\\\">\\n          <h2 className=\\\"text-3xl md:text-5xl font-bold tracking-tighter mb-4\\\">\\n            Common <span className=\\\"text-accent\\\">Questions.</span>\\n          </h2>\\n        </div>\\n        \\n        <div className=\\\"space-y-4\\\">\\n          {faqs.map((faq, index) => (\\n            <div \\n              key={index} \\n              className=\\\"border border-border bg-background rounded-sm overflow-hidden\\\"\\n            >\\n              <button \\n                onClick={() => setOpenIndex(openIndex === index ? null : index)}\\n                className=\\\"w-full p-6 flex items-center justify-between text-left hover:bg-border/30 transition-colors\\\"\\n              >\\n                <span className=\\\"font-bold text-lg\\\">{faq.question}</span>\\n                {openIndex === index ? <Minus size={20} /> : <Plus size={20} />}\\n              </button>\\n              <AnimatePresence>\\n                {openIndex === index && (\\n                  <motion.div \\n                    initial={{ height: 0, opacity: 0 }}\\n                    animate={{ height: 'auto', opacity: 1 }}\\n                    exit={{ height: 0, opacity: 0 }}\\n                    transition={{ duration: 0.3 }}\\n                    className=\\\"overflow-hidden\\\"\\n                  >\\n                    <div className=\\\"p-6 pt-0 text-muted leading-relaxed border-t border-border/50 mt-2\\\">\\n                      {faq.answer}\\n                    </div>\\n                  </motion.div>\\n                )}\\n              </AnimatePresence>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\",\n  \"createParentDirectories\": true\n}","msg":"Tool call: createFile"}
