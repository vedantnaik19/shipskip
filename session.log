{"level":20,"time":1777760455085,"pid":2295,"hostname":"runnervmeorf1","input":"{\n  \"path\": \"components/HowItWorks.tsx\",\n  \"content\": \"\\\"use client\\\";\\nimport React from 'react';\\nimport { motion } from 'framer-motion';\\nimport { CheckCircle2, ArrowRight } from 'lucide-react';\\n\\nconst steps = [\\n  {\\n    title: 'Connect Your Stack',\\n    description: 'Authorize your favorite tools via OAuth in seconds. We support 200+ production-ready integrations.',\\n    step: '01'\\n  },\\n  {\\n    title: 'Map the Logic',\\n    description: 'Use our visual canvas to define triggers and actions. If X happens in Linear, then do Y in Slack.',\\n    step: '02'\\n  },\\n  {\\n    title: 'Deploy & Monitor',\\n    description: 'Activate your workflow and watch it run in real-time. Get notified instantly if anything breaks.',\\n    step: '03'\\n  },\\n];\\n\\nexport default function HowItWorks() {\\n  return (\\n    <section id=\\\"how-it-works\\\" className=\\\"py-24 bg-background relative overflow-hidden\\\">\\n      <div className=\\\"absolute inset-0 bg-grid opacity-20 -z-10\\\" />\\n      \\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"grid lg:grid-cols-2 gap-16 items-center\\\">\\n          <div>\\n            <h2 className=\\\"text-3xl md:text-5xl font-bold tracking-tighter mb-8\\\">\\n              From Chaos to <span className=\\\"text-accent\\\">Clockwork.</span>\\n            </h2>\\n            \\n            <div className=\\\"space-y-12\\\">\\n              {steps.map((step, index) => (\\n                <div key={index} className=\\\"flex gap-6\\\">\\n                  <div className=\\\"flex-shrink-0 w-12 h-12 rounded-sm border border-border flex items-center justify-center font-mono text-accent font-bold\\\">\\n                    {step.step}\\n                  </div>\\n                  <div>\\n                    <h3 className=\\\"text-xl font-bold mb-2\\\">{step.title}</h3>\\n                    <p className=\\\"text-muted leading-relaxed\\\">{step.description}</p>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n          \\n          <div className=\\\"relative\\\">\\n            <div className=\\\"relative aspect-square max-w-md mx-auto rounded-lg border border-border bg-background p-8 shadow-2xl overflow-hidden\\\">\\n              {/* Mock Workflow UI */}\\n              <div className=\\\"space-y-6 relative z-10\\\">\\n                <div className=\\\"flex items-center gap-4 p-3 bg-border/30 border border-border rounded-sm\\\">\\n                  <div className=\\\"w-8 h-8 bg-accent/20 rounded-sm\\\" />\\n                  <div className=\\\"flex-1 h-3 bg-muted/20 rounded-full\\\" />\\n                  <CheckCircle2 size={16} className=\\\"text-green-500\\\" />\\n                </div>\\n                <div className=\\\"flex justify-center\\\">\\n                  <ArrowRight size={20} className=\\\"text-border rotate-90\\\" />\\n                </div>\\n                <div className=\\\"flex items-center gap-4 p-3 bg-border/30 border border-border rounded-sm\\\">\\n                  <div className=\\\"w-8 h-8 bg-accent/20 rounded-sm\\\" />\\n                  <div className=\\\"flex-1 h-3 bg-muted/20 rounded-full\\\" />\\n                  <CheckCircle2 size={16} className=\\\"text-green-500\\\" />\\n                </div>\\n                <div className=\\\"flex justify-center\\\">\\n                  <ArrowRight size={20} className=\\\"text-border rotate-90\\\" />\\n                </div>\\n                <div className=\\\"flex items-center gap-4 p-3 bg-accent/10 border border-accent/50 rounded-sm\\\">\\n                  <div className=\\\"w-8 h-8 bg-accent rounded-sm\\\" />\\n                  <div className=\\\"flex-1 h-3 bg-accent/20 rounded-full\\\" />\\n                  <div className=\\\"w-4 h-4 border-2 border-accent border-t-transparent rounded-full animate-spin\\\" />\\n                </div>\\n              </div>\\n              \\n              {/* Background Decoration */}\\n              <div className=\\\"absolute top-0 right-0 p-4 font-mono text-[10px] text-muted opacity-30\\\">\\n                STATUS: EXECUTING_STEP_3\\n              </div>\\n   \n\n[Output truncated for length]","msg":"Tool call: createFile"}
