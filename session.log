{"level":20,"time":1777760571243,"pid":2295,"hostname":"runnervmeorf1","input":"{\n  \"path\": \"components/Testimonials.tsx\",\n  \"content\": \"\\\"use client\\\";\\nimport React from 'react';\\nimport { motion } from 'framer-motion';\\nimport { Quote } from 'lucide-react';\\n\\nconst testimonials = [\\n  {\\n    name: 'Sarah Chen',\\n    role: 'Head of Operations',\\n    company: 'Vellum AI',\\n    content: 'Flowmatic didn\\\\'t just save us hours of work; it completely changed how we think about our operations. The visual builder is intuitive but powerful enough for our most complex logic.',\\n  },\\n  {\\n    name: 'Marcus Thorne',\\n    role: 'CTO',\\n    company: 'Nexus Systems',\\n    content: 'Finally, a tool that feels like it was built for engineers but can be used by the whole team. The reliability and the real-time monitoring are absolute game changers.',\\n  },\\n  {\\n    name: 'Elena Rodriguez',\\n    role: 'Product Manager',\\n    company: 'Stellar Flow',\\n    content: 'We reduced our onboarding time by 70% by automating the handoff between sales and product. Flowmatic is the glue that holds our fragmented toolset together.',\\n  },\\n];\\n\\nexport default function Testimonials() {\\n  return (\\n    <section className=\\\"py-24 border-t border-border\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"text-center mb-16\\\">\\n          <h2 className=\\\"text-3xl md:text-5xl font-bold tracking-tighter mb-4\\\">\\n            Trusted by <span className=\\\"text-accent\\\">High-Velocity</span> Teams.\\n          </h2>\\n        </div>\\n        \\n        <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n          {testimonials.map((t, index) => (\\n            <div key={index} className=\\\"p-8 border border-border bg-background relative\\\">\\n              <Quote size={40} className=\\\"text-accent/20 absolute top-6 right-6\\\" />\\n              <div className=\\\"relative z-10\\\">\\n                <p className=\\\"text-lg leading-relaxed mb-8 text-muted\\\">\\n                  \\\"{t.content}\\\"\\n                </p>\\n                <div>\\n                  <div className=\\\"font-bold\\\">{t.name}</div>\\n                  <div className=\\\"text-xs font-mono text-muted uppercase tracking-tighter\\\">\\n                    {t.role} @ {t.company}\\n                  </div>\\n                </div>\\n              </div>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\",\n  \"createParentDirectories\": true\n}","msg":"Tool call: createFile"}
